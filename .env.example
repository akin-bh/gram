# Copy to .env. Variables already set in the process environment take precedence.

# Live agent runs and Claude scenario generation.
ANTHROPIC_API_KEY=

# Optional default world generator: Gemini Argon on Vertex AI. Without both, generation uses Claude.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=

# Optional verified Argon rates in USD per million tokens, as one line of JSON:
# FINANCE_WORLD_ARGON_PRICING={"inputUsdPerMillion":0,"cachedInputUsdPerMillion":0,"outputUsdPerMillion":0,"source":"where these rates came from"}

# Optional Slack for the seats (docs/slack-app-manifest.yaml): cards for approvals, questions
# and policies, and "@gram why <record>" answered from the work log.
# Bot token (xoxb-), app-level token with connections:write (xapp-), the channel ID,
# and the Slack user IDs allowed to act: accountants answer and approve work items;
# controllers also decide policy. Anyone else is refused and the refusal is audited.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=
SLACK_TEAM_ID=
SLACK_ACCOUNTANTS=
SLACK_CONTROLLERS=

# The cash-application seat's model. It defaults to the current Opus with effort set explicitly
# (Opus 5.5 defaults to medium) and falls back to Sonnet only if Opus is unavailable.
# FINANCE_WORLD_SEAT_MODEL=claude-opus-5-5
# FINANCE_WORLD_SEAT_EFFORT=high
# FINANCE_WORLD_SEAT_FALLBACK_MODEL=claude-sonnet-5-5

# Capital One Nessie API key (https://api.nessieisreal.com). When set, the festival finance
# seat can sync its world state to the live Nessie API via nessie-api.ts.
NESSIE_API_KEY=

# Seat runs per company per hour (default 12). Raise it on a demo machine that replays a month quickly.
# FINANCE_WORLD_SEAT_RUNS_PER_HOUR=60
